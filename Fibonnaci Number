//using top-bottom approach
class Solution { 
public:
    int f1(int n, vector<int>& dp){
        if(n<=1) return n;
        if(dp[n]!=-1) return dp[n];
        dp[n] = f1(n-1, dp)+f1(n-2, dp);
        return dp[n];
    }
    int fib(int n) {
        vector<int>dp(n+1,-1);
        int result = f1(n, dp);
        return result;
    }
};

//using bottom-up approach

class Solution {
public:
    int fib(int n) {
        vector<int>dp(n+1,-1);
        if(n==0 || n==1) return n;
        dp[0]=0;
        dp[1]=1;
        for(int i=2;i<=n;i++){
            dp[i] = dp[i-1] + dp[i-2];
        }
        return dp[n];
    }
};

//optimizing space complexity

class Solution {
public:
    int fib(int n) {
        if(n == 0 || n == 1) return n;
        int prev1 = 1, prev2 = 0, curr = 0;
        for(int i=2;i<=n;i++){
            curr = prev1 + prev2;
            prev2=prev1;
            prev1=curr;
        }
        return curr;
    }
};
