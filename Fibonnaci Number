class Solution {
public:
    int f1(int n, vector<int>& dp){
        if(n<=1) return n;
        if(dp[n]!=-1) return dp[n];
        dp[n] = f1(n-1, dp)+f1(n-2, dp);
        return dp[n];
    }
    int fib(int n) {
        vector<int>dp(n+1,-1);
        int result = f1(n, dp);
        return result;
    }
};
